{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account, active role selection, and private Customer profile details.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase user UID."
        },
        "displayName": {
          "type": "string",
          "description": "User full name (auto-filled from Google Sign-In and editable)."
        },
        "email": {
          "type": "string",
          "description": "Google account email address (private to owner)."
        },
        "role": {
          "type": "string",
          "enum": ["UNSET", "CUSTOMER", "KARIGAR"],
          "description": "Selected active role in the app."
        },
        "phone": {
          "type": "string",
          "description": "Customer phone or WhatsApp number."
        },
        "town": {
          "type": "string",
          "description": "Selected Karachi town/area for the customer."
        },
        "address": {
          "type": "string",
          "description": "Customer street, block, or gali address in Karachi."
        },
        "karigarCategory": {
          "type": "string",
          "description": "Partner selected category among the 12 services."
        },
        "karigarRate": {
          "type": "string",
          "description": "Partner service rate (e.g. Rs. 2500/day)."
        },
        "karigarActive": {
          "type": "boolean",
          "description": "Partner listing active status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "displayName", "role", "createdAt", "updatedAt"]
    },
    "KarigarProfile": {
      "title": "KarigarProfile",
      "description": "Karigar or transport partner service listing visible to signed-in customers when active.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase UID matching document ID."
        },
        "fullName": {
          "type": "string",
          "description": "Karigar or transport partner full name."
        },
        "category": {
          "type": "string",
          "enum": [
            "Mistri",
            "Mazdoor",
            "Plumber",
            "Electrician",
            "Painter",
            "Carpenter",
            "AC Technician",
            "Tile Fixer",
            "Shadi / Event Bus",
            "Long Route Coaster",
            "Car / Rent a Car",
            "Goods Delivery Truck"
          ],
          "description": "One of the 12 Karachi trade or transport categories."
        },
        "town": {
          "type": "string",
          "enum": [
            "Baldia Town",
            "Orangi Town",
            "Gulshan-e-Iqbal",
            "Gulistan-e-Jauhar",
            "North Nazimabad",
            "DHA / Clifton",
            "Saddar / Lyari",
            "Korangi / Landhi",
            "Malir / Shah Faisal"
          ],
          "description": "Karachi town where the partner operates."
        },
        "exactLocation": {
          "type": "string",
          "description": "Exact gali, sector, or landmark in Karachi."
        },
        "phone": {
          "type": "string",
          "description": "Business phone/WhatsApp contact number."
        },
        "rate": {
          "type": "string",
          "description": "Service rate (e.g. Rs. 2500/day or Rs. 15000/trip)."
        },
        "active": {
          "type": "boolean",
          "description": "Whether the Karigar listing is live for customer search."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "ownerId",
        "fullName",
        "category",
        "town",
        "exactLocation",
        "phone",
        "rate",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingRequest": {
      "title": "BookingRequest",
      "description": "Booking request created by a Customer for a specific Karigar Partner.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "Customer Firebase UID."
        },
        "karigarId": {
          "type": "string",
          "description": "Target Karigar document ID / owner UID."
        },
        "customerName": {
          "type": "string",
          "description": "Customer name at booking time."
        },
        "customerPhone": {
          "type": "string",
          "description": "Customer phone/WhatsApp number at booking time."
        },
        "customerArea": {
          "type": "string",
          "description": "Customer Karachi area and address."
        },
        "karigarName": {
          "type": "string",
          "description": "Karigar full name snapshot."
        },
        "karigarCategory": {
          "type": "string",
          "description": "Karigar category snapshot."
        },
        "karigarTown": {
          "type": "string",
          "description": "Karigar town snapshot."
        },
        "karigarPhone": {
          "type": "string",
          "description": "Karigar phone snapshot."
        },
        "karigarRate": {
          "type": "string",
          "description": "Karigar rate snapshot."
        },
        "details": {
          "type": "string",
          "description": "Optional job or trip instructions from the customer."
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "ACCEPTED", "COMPLETED", "DECLINED", "CANCELLED"],
          "description": "Booking lifecycle status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "customerId",
        "karigarId",
        "customerName",
        "customerPhone",
        "customerArea",
        "karigarName",
        "karigarCategory",
        "karigarTown",
        "karigarPhone",
        "karigarRate",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account and customer profile document keyed by Firebase UID."
    },
    "/karigars/{karigarId}": {
      "schema": { "$ref": "#/entities/KarigarProfile" },
      "description": "Karigar and transport partner service profiles keyed by owner Firebase UID."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRequest" },
      "description": "Service booking requests linking customers and karigar partners."
    }
  }
}
